# Real Email Delivery Configuration (Optional - for real email delivery to your Gmail/inbox)
#
# To send real emails from your Gmail account:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Rename this file to .env and fill in your details:

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Netflix Watch Spaces <your_email@gmail.com>
